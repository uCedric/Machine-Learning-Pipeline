# monitor-service environment.
#
# Copy to `.env` and fill in the secrets. The values below are tuned for running
# the app standalone (e.g. `uvicorn app:app` on the host), pointing at the ports
# the stack publishes on localhost.
#
# NOTE: under docker-compose these are supplied by the root `.env`, and
# POSTGRES_HOST / POSTGRES_PORT / MINIO_ENDPOINT are overridden to the in-network
# names (postgres:5432, minio:9000) — so you do not need this file for compose.

# ── PostgreSQL (reads the inference_results table) ───────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=postgres

# ── MinIO (proxies image / heatmap bytes for display) ────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_SECURE=false
IMAGES_BUCKET=images
