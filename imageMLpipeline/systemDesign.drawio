  <diagram id="OOhk3NKuLrwdCNrawJ6z" name="stage-one_training_seq">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n  autonumber\n  actor Developer_Or_System as Upstream System\n  participant KF as Kafka Topic\n  participant TS as Training Service\n  participant DB as Postgres (Metadata DB)\n  participant SS as MinIO + Iceberg (Storage)\n\n  Note over Developer_Or_System, KF: Step 1: Trigger Training Event\n  Developer_Or_System-&gt;&gt;KF: Publish \&quot;train\&quot; event (with model_id &amp; dataset_config)\n\n  Note over KF, TS: Step 2: Consume and Analyze\n  activate TS\n  KF-&gt;&gt;TS: Consume \&quot;train\&quot; event\n  TS-&gt;&gt;TS: Analyze event payload &amp; validate schema\n\n  Note over TS, DB: Step 3: Retrieve ML Model &amp; Data Info\n  TS-&gt;&gt;DB: Query old model metadata &amp; current status (model_id)\n  DB--&gt;&gt;TS: Return model architecture &amp; hyper-parameters\n  TS-&gt;&gt;SS: Fetch training/historical dataset via Apache Iceberg\n  SS--&gt;&gt;TS: Stream images &amp; annotation tables\n  TS-&gt;&gt;TS: Execute model retraining &amp; update Memory Bank\n  deactivate TS\n\n  Note over TS, SS: Step 4: Store New Artifacts &amp; Update Status\n  activate TS\n  TS-&gt;&gt;SS: Upload new ONNX model weights &amp; Memory Bank (.onnx / .onnx.data)\n  SS--&gt;&gt;TS: Acknowledge upload success (return S3 object path)\n  TS-&gt;&gt;DB: Update model metadata, save memory bank features index &amp; update status to &#39;READY&#39;\n  DB--&gt;&gt;TS: Confirm database transaction committed\n  deactivate TS\n\n  Note over TS: Training Pipeline Completed Successfully&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="nDLO1pCnutP_-QL2iKUX-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=20;" vertex="1">
