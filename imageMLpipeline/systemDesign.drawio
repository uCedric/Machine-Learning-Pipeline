  <diagram id="Ad0NK6_AX16NiPloitW_" name="stage-one_retrain_loop_seq">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    actor Op as Operator\n    participant UI as Browser (index.html)\n    participant Mon as monitor-service&lt;br/&gt;POST /api/retrain\n    participant PG as Postgres\n    participant K as Kafka (topic: train)\n    participant Tr as train-service&lt;br/&gt;(consumer → RunTraining)\n    participant S3 as MinIO\n\n    Op-&gt;&gt;UI: tick pending checkbox(es), click \&quot;Retrain selected\&quot;\n    UI-&gt;&gt;UI: idemKey = crypto.randomUUID()\n    UI-&gt;&gt;Mon: POST {event_ids} + Idempotency-Key\n\n    alt key cached or in-flight\n        Mon--&gt;&gt;UI: cached response / 409 (nothing published)\n    else new key\n        Mon-&gt;&gt;PG: SELECT bucket, object_key, model_type&lt;br/&gt;WHERE event_id = ANY(..) AND status=&#39;pending&#39;\n        PG--&gt;&gt;Mon: pending rows (re-validated server-side)\n        loop each pending row\n            Mon-&gt;&gt;K: produce {event:\&quot;train\&quot;, model, images:\&quot;/bucket/key\&quot;}\n        end\n        Mon-&gt;&gt;Mon: cache response under Idempotency-Key\n        Mon--&gt;&gt;UI: {published: N}\n    end\n\n    UI--&gt;&gt;Op: \&quot;triggered retraining for N image(s)\&quot;\n\n    Note over K,Tr: asynchronous\n    K--&gt;&gt;Tr: deliver train event\n    Tr-&gt;&gt;PG: registry.latest(model_type) → base (is_valid=true)\n    PG--&gt;&gt;Tr: base version (e.g. v1.0.0)\n    Tr-&gt;&gt;S3: get original image bytes\n    Tr-&gt;&gt;S3: load base memory bank\n    Tr-&gt;&gt;Tr: embed → subsample → append to bank\n    Tr-&gt;&gt;PG: recent_good(model_type, N) validation set\n    Tr-&gt;&gt;S3: fetch+score validation imgs → buffer zone P75/P99\n    Tr-&gt;&gt;PG: next_version = MAX(patch)+1 → v1.0.x\n    Tr-&gt;&gt;S3: save bank + buffer zone + copy assets → {model_type}/{v1.0.x}/\n    Tr-&gt;&gt;PG: register(v1.0.x, is_valid=false)  ← candidate\n    Tr-&gt;&gt;K: commit offset (at-least-once)&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="LcrKMzVBnHhj1JKYI3Lg-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=20;" vertex="1">
            <mxGeometry height="1670" width="2362" as="geometry" />
          </mxCell>
        </UserObject>
